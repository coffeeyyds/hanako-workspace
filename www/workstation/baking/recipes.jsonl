{"recipe_id": "b4908e76", "title": "微信覆盖测试", "description": "", "cover_image": "https://mmbiz.qpic.cn/mmbiz_jpg/6Wjfia9v3uHiaXL6BgJfGKOGETJ0C44ZOpI1QhUPCf6zUPFJTFm5JESV9fBFKhqg0ewZg3LQ2y8QvcYMRX1jlQRA/0?wx_fmt=jpeg", "source_url": "", "source_type": "manual", "ingredients": [], "steps": [], "temperature": "", "time": "", "servings": "", "tips": [], "tags": [], "uploader_nickname": "测试", "status": "deleted", "edit_token": "c463315e3af26ab4bbcea8e9de2f37d6", "created_at": "2026-06-01T17:22:48.574389", "updated_at": "2026-06-01T17:22:58.524401"}
{"recipe_id": "6143a941", "title": "低含水量手撕吐司", "description": "材料", "cover_image": "workstation/baking/images/023be815.jpg", "source_url": "https://mp.weixin.qq.com/s/9_w3MpN4dnYw6UqZhlFMxQ", "source_type": "wechat", "ingredients": [{"name": "高筋面包粉", "amount": "适量"}, {"name": "牛奶", "amount": "适量（比常规配方减少约50-60g）"}, {"name": "鸡蛋", "amount": "适量"}, {"name": "糖", "amount": "适量"}, {"name": "盐", "amount": "适量"}, {"name": "酵母", "amount": "适量"}, {"name": "黄油", "amount": "适量"}], "steps": [{"text": "先液体后固体，把除了黄油以外所有的材料全部放进打面桶里。尽量不让糖、盐和酵母直接接触。"}, {"text": "厨师机低速混合（3档2-3分钟），成团后转高速（5档以上）打面约10分钟，至能拉出厚膜。"}, {"text": "加入软化的黄油，低速混合至看不见黄油，成团后转高速（5档）打3-5分钟，至能拉出薄膜。"}, {"text": "面团出缸后，盖碗或保鲜膜静置松弛15-30分钟。"}, {"text": "分成三团，擀成宽短长方形后卷起；全部卷完后，重新擀成窄长长方形再卷起，放入吐司盒。"}, {"text": "35℃发酵至八分满（带盖）或九分满（不带盖），约2小时。"}, {"text": "预热烤箱：带盖180℃，不带盖175℃。烘烤35分钟（带盖）；不带盖在第12分钟时检查上色并盖锡纸。"}, {"text": "出炉后震出热气，晾凉再切。"}], "temperature": "180℃（带盖）/ 175℃（不带盖）", "time": "35分钟", "servings": "1个吐司", "tips": ["含水量约51%，上下浮动5%，不建议低于50%。", "面粉蛋白质含量12.8%左右。", "打面时面温尽量不超过26℃。", "整形过程中无需撒粉。", "烘烤时间需根据自家烤箱调整。"], "tags": [], "uploader_nickname": "测试", "status": "deleted", "edit_token": "a4ace1dfa658b10c2282219634f1e1fd", "created_at": "2026-06-01T17:25:20.917722", "updated_at": "2026-06-01T17:26:22.655227"}
